{% extends 'base.html.twig' %}

{% block titulo %}Listado de reservas{% endblock %}

{% block contenido %}
    <h1>Reservas</h1>

    <form id="form-filtros" class="filtros">
        <label>
            Estado
            <select name="estado">
                <option value="">Todos</option>
                <option value="pendiente">Pendiente</option>
                <option value="confirmada">Confirmada</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </label>
        <label>
            Entrada desde
            <input type="date" name="desde">
        </label>
        <label>
            Entrada hasta
            <input type="date" name="hasta">
        </label>
        <label>
            Huésped
            <input type="search" name="nombre" maxlength="150" placeholder="Nombre">
        </label>
        <button type="submit">Filtrar</button>
        <button type="reset">Limpiar</button>
    </form>

    <p id="aviso" role="status" hidden></p>

    <table>
        <thead>
        <tr>
            <th scope="col">Huésped</th>
            <th scope="col">Alojamiento</th>
            <th scope="col">Entrada</th>
            <th scope="col">Salida</th>
            <th scope="col">Importe</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
        </tr>
        </thead>
        <tbody id="tabla-reservas">
        {% for reserva in reservas %}
            <tr>
                <td>{{ reserva.nombre_huesped }}</td>
                <td>{{ reserva.nombre_alojamiento }}</td>
                <td>{{ reserva.fecha_entrada|date('d/m/Y') }}</td>
                <td>{{ reserva.fecha_salida|date('d/m/Y') }}</td>
                <td>{{ reserva.importe|number_format(2, ',', '.') }} €</td>
                <td><span class="estado estado-{{ reserva.estado }}">{{ reserva.estado|capitalize }}</span></td>
                <td>
                    <a href="/reservas/{{ reserva.id }}">Ver</a>
                    {% if reserva.estado != 'cancelada' %}
                        <button type="button" class="btn-cancelar" data-id="{{ reserva.id }}">Cancelar</button>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">No hay reservas.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}

{% block scripts %}
    <script src="/js/app.js"></script>
{% endblock %}
